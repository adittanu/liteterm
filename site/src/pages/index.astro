---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Compare from '../components/Compare.astro';
import Platforms from '../components/Platforms.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';

const title = 'LiteTerm: lightweight SSH client for Windows, macOS and Linux';
const description =
  'A small, free and open source SSH client for Windows, macOS and Linux: terminal, SFTP, port forwarding and notes in one window. A Termius alternative.';
---

<Layout title={title} description={description}>
  <Nav />
  <main id="main">
    <Hero />
    <Features />
    <Compare />
    <Platforms />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Layout>
