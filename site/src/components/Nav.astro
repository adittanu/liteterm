---
import { release, REPO_URL } from '../data/release';
import { withBase } from '../utils/url';
import Logo from './Logo.astro';
import GithubMark from './GithubMark.astro';
import DownloadButton from './DownloadButton.astro';
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={withBase()}>
      <Logo size={28} />
      <span class="brand-name">LiteTerm</span>
      <span class="version" title="Latest release">v{release.version}</span>
    </a>

    <nav class="links" aria-label="Sections">
      <a href="#features">Features</a>
      <a href="#platforms">Platforms</a>
      <a href="#limits">Limits</a>
      <a href="#faq">FAQ</a>
    </nav>

    <div class="actions">
      <a class="gh" href={REPO_URL} aria-label="LiteTerm on GitHub">
        <GithubMark size={20} />
        <span class="gh-text">GitHub</span>
      </a>
      <DownloadButton size="small" short />
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    height: var(--nav-h);
    border-block-end: 1px solid var(--line);
    background: oklch(0.155 0.012 260 / 0.82);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    text-decoration: none;
  }

  .brand-name {
    font-size: var(--step-1);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .version {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .links {
    display: none;
    gap: var(--space-5);
    margin-inline-start: auto;
  }

  .links a {
    color: var(--text-2);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .links a:hover {
    color: var(--text);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-inline-start: auto;
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-2);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .gh:hover {
    color: var(--text);
  }

  .gh-text {
    display: none;
  }

  @media (min-width: 52rem) {
    .links {
      display: flex;
    }

    .actions {
      margin-inline-start: 0;
    }

    .gh-text {
      display: inline;
    }
  }

  @media (max-width: 26rem) {
    .version {
      display: none;
    }
  }

  /* 320px phones: the hero carries the GitHub link, the nav keeps the download */
  @media (max-width: 22rem) {
    .gh {
      display: none;
    }
  }
</style>
