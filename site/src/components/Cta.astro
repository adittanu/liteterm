---
import { REPO_URL } from '../data/release';
import DownloadButton from './DownloadButton.astro';
import GithubMark from './GithubMark.astro';
---

<section class="section" id="download" aria-labelledby="cta-title">
  <div class="container">
    <div class="panel">
      <h2 id="cta-title">Open your first connection in a minute.</h2>
      <p>Install LiteTerm, add a host, or press Ctrl K and paste an address.</p>
      <div class="actions">
        <DownloadButton />
        <a class="btn btn-secondary" href={REPO_URL}>
          <GithubMark size={18} />
          Star on GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: clamp(2.5rem, 2rem + 4vw, 5rem) var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(40rem 16rem at 50% 0%, oklch(0.55 0.19 255 / 0.22), transparent 70%),
      var(--surface);
    text-align: center;
  }

  h2 {
    max-width: 18ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }
</style>
