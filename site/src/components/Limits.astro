---
// Straight from the project's own list of limits (README "Batasan") and the app's behavior.
const limits = [
  {
    title: 'Interrupted transfers start over',
    text: 'SFTP does not resume a file or folder transfer that broke off.',
  },
  {
    title: 'No agent forwarding, no Pageant',
    text: 'The OpenSSH agent, 1Password, Bitwarden and KeePassXC all work.',
  },
  {
    title: 'Sync carries key paths, not key files',
    text: 'A synced host remembers where its private key is. Copy the key to the same place on the other computer, or use an SSH agent. Images in notes don’t sync yet.',
  },
  {
    title: 'macOS and Linux are new',
    text: 'Those builds come from CI and have had far less testing than the Windows one.',
  },
  {
    title: 'Mac updates need the Applications folder',
    text: 'Started from the disk image, or straight from Downloads, LiteTerm can’t replace itself and opens the download page instead.',
  },
];
---

<section class="section" id="limits" aria-labelledby="limits-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow"><b>04</b> · Limits</p>
      <h2 id="limits-title">What LiteTerm doesn’t do yet.</h2>
      <p class="lede">Better to read this before you install than to find out after.</p>
    </div>

    <ul class="limits">
      {
        limits.map((l) => (
          <li>
            <h3>{l.title}</h3>
            <p set:html={l.text} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .limits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-7);
  }

  .limits li {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--line-strong);
  }

  .limits :global(code) {
    padding: 0.05em 0.35em;
    border-radius: 5px;
    background: var(--surface-2);
    color: var(--text);
    white-space: nowrap;
  }

  .limits h3 {
    font-size: var(--step-0);
  }

  .limits p {
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  @media (max-width: 44rem) {
    .limits {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
